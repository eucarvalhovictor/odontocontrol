# Copie para .env e preencha com os seus valores
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-ANON-KEY

# Stripe PRODUÇÃO
# Payment Link live (Dashboard Stripe → Pagamentos → Links de pagamento):
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/5kQ7sKdukaVw7qi6B8eUU00
# Chave publicável LIVE (pk_live_...). A secreta (sk_live) NUNCA vai no frontend —
# ela fica só no webhook (Supabase Edge Function stripe-webhook).
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
